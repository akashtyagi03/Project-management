# API
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection URI)
# For local MongoDB: mongodb://127.0.0.1:27017/project_management
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/project_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/project_management

# File Uploads
UPLOADS_DIR=server/uploads

# Seed demo data on initial startup (true/false)
SEED_DEMO=true
